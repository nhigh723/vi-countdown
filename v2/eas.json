      }
    },
    "production-nogroup": {
      "extends": "production",
      "env": {
        "CVI_APP_GROUP": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "Z3S5X9HZXU",
        "bundleIdentifier": "com.nickhigh.vicountdown",
        "ascAppId": "6834272574"
      }
    }
  }
}
